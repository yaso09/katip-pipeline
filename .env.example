# GitHub API Entegrasyonu için gerekli bilgiler
GITHUB_TOKEN=senin_github_tokenin_buraya
GITHUB_REPO=KullaniciAdi/RepoAdi

# GitHub OAuth Login (Yönetici Paneli İçin)
# Callback URL: http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=oauth_app_client_id
GITHUB_CLIENT_SECRET=oauth_app_client_secret
ADMIN_GITHUB_USERNAME=KullaniciAdi
